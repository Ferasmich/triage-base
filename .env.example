LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Verified replacement: nvidia/nemotron-3.5-lightning-30b-a3b
# For Lightning, set false to keep reasoning within the existing output budget.
# Omit for providers/models without chat_template_kwargs support.
LLM_ENABLE_THINKING=false
# Optional: label used in logs. Defaults to the base URL hostname.
LLM_PROVIDER=
# prompt or json_schema; local Zod validation always runs.
LLM_OUTPUT_MODE=prompt
# USD per million tokens. Empty means unknown, not zero.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# Hosted Decision Model (server only). Obtain a free key at https://decision.vllm-sr.ai/keys
DECISION_API_KEY=
DM_BASE_URL=https://decision.vllm-sr.ai
DM_MODEL=vllm-sr/d3-flash
